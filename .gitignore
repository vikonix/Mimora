# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual Environment
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Audio. The diagnostic take dumps moved to logs/records/ (covered by the logs/
# rule below); records/ stays listed for the machines that still have the old
# directory, where *.wav alone would leave phrase.txt showing up in git status.
records/
*.wav
*.mp3
*.flac

# Logs
*.log
*.csv
logs/

# Per-machine pronunciation calibration (voice/mic specific). The app writes
# the config/ form; the in-package paths are the libraries' own standalone
# default and stay listed for host-less use of pronunciation/*.
config/calibration_acoustic.json
config/calibration_phoneme.json
pronunciation/acoustic/calibration.json
pronunciation/phoneme/calibration.json

# Per-machine hardware config (generated by python -m mimora.detect_hardware)
config/hardware_config.json
hwconfig/hardware_config.json

# Local HuggingFace model cache (Kokoro / Wav2Vec2 weights)
model_cache/

# Environment
.env
.env.local
.kilo

# Models
*.gguf

# Downloaded llama.cpp binaries (populated by mimora/llama_server_fetch.py;
# ~1 GB of exe/DLL per install, re-fetchable from the pinned release)
bin/

# User settings (machine-local; copy config/settings.example.json to start)
config/settings.json

# Custom texts (personal practice texts stay local; the bundled starter
# texts are tracked and unaffected by this rule)
texts/

prototypes-pronunciation/

# Run scripts
run_mimora.*
