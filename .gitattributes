# Normalize line endings in the repository to LF so whole-file CRLF/LF churn
# stops showing up in diffs (checkout still uses the platform default).
* text=auto

# Shell scripts always LF: a Windows checkout (also the Windows runner of the
# release workflow) otherwise gives them CRLF, and sh fails on the "\r".
*.sh text eol=lf

# Binary assets — never normalize.
*.gguf binary
*.wav binary
*.bin binary
*.pt binary
*.pth binary
